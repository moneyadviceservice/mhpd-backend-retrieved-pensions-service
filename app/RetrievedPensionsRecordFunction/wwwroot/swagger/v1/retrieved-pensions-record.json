{
  "swagger": "2.0",
  "info": {
    "title": "MaPS Retrieved Pension Records",
    "description": "This service allows a client to retrieve retrieved pension records related to a user session",
    "contact": {
      "name": "General Enquires",
      "url": "https://maps.org.uk/en/about-us/contact-us",
      "email": "contact@maps.org.uk"
    },
    "license": {
      "name": "Government API License",
      "url": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
    }
  },
  "host": "localhost:7289",
  "schemes": [
    "http"
  ],
  "paths": {
    "/api/retrieved-peis": {
      "get": {
        "tags": [
          "RetrievedRecordsFunction"
        ],
        "summary": "Get Retrieved Pension Records",
        "description": "Get the retrieved retrieved-pensions-records that contains pensions information has been retrieved from the PDP Ecosystem for peis.",
        "operationId": "get-retrieved-peis",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "userSessionId",
            "description": "The unique id of pension owner session as issued by the requesting system",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "header",
            "name": "mhpdCorrelationId",
            "description": "An Id with which to group all logging statements made during a single session",
            "type": "string",
            "format": "uuid"
          }
        ],
        "responses": {
          "200": {
            "description": "The array of Retrieved Peis that match the provided query parameters",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "504": {
            "description": "Gateway Timeout"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "502": {
            "description": "Bad Gateway"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/retrieved-pension-records": {
      "get": {
        "tags": [
          "RetrievedRecordsFunction"
        ],
        "summary": "Get Retrieved Pension Records",
        "description": "Get the retrieved retrieved-pensions-records that contains pensions information has been retrieved from the PDP Ecosystem for peis.",
        "operationId": "get-retrieved-pensions-records",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "userSessionId",
            "description": "The unique id of pension owner session as issued by the requesting system",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "header",
            "name": "mhpdCorrelationId",
            "description": "An Id with which to group all logging statements made during a single session",
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "query",
            "name": "category",
            "description": "Gets a subset of the pensions retrieval records that have the specified classification.",
            "type": "string"
          },
          {
            "in": "query",
            "name": "assetId",
            "description": "Gets a specific pensions retrieval record with the specified Id.",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "The array of Retrieved Pension Records that match the provided query parameters",
            "schema": {
              "$ref": "#/definitions/RetrievedPensionRecord"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "504": {
            "description": "Gateway Timeout"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "502": {
            "description": "Bad Gateway"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      },
      "delete": {
        "tags": [
          "RetrievedRecordsFunction"
        ],
        "summary": "Delete Pensions Retrieved Record",
        "description": "Deletes the given pension retrieved records given userSessionId",
        "operationId": "delete-pensions-retrieved-records-id",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "userSessionId",
            "description": "The unique id of pension owner session as issued by the requesting system",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "header",
            "name": "mhpdCorrelationId",
            "description": "An Id with which to group all logging statements made during a single session",
            "type": "string",
            "format": "uuid"
          }
        ],
        "responses": {
          "200": {
            "description": "The number of records deleted as part of the request",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          "504": {
            "description": "Gateway Timeout"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request"
          },
          "502": {
            "description": "Bad Gateway"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/service/status": {
      "get": {
        "tags": [
          "RetrievedRecordsFunction"
        ],
        "summary": "Get Service Status",
        "description": "Gets the deployed version information of the service",
        "operationId": "get-status",
        "responses": {
          "200": {
            "description": "Status Data"
          }
        }
      }
    }
  },
  "definitions": {
    "IActionResult": {
      "type": "object",
      "additionalProperties": false
    },
    "RetrievedPensionRecord": {
      "type": "object",
      "properties": {
        "correlationId": {
          "type": "string",
          "x-nullable": true
        },
        "pei": {
          "type": "string",
          "x-nullable": true
        },
        "userSessionId": {
          "type": "string",
          "x-nullable": true
        },
        "pensionType": {
          "type": "string",
          "x-nullable": true
        },
        "matchType": {
          "type": "string",
          "x-nullable": true
        },
        "assetId": {
          "type": "string",
          "x-nullable": true
        },
        "category": {
          "type": "string",
          "x-nullable": true
        },
        "schemeName": {
          "type": "string",
          "x-nullable": true
        },
        "hasIncome": {
          "type": "boolean"
        },
        "isMcCloudPension": {
          "type": "boolean"
        },
        "administratorName": {
          "type": "string",
          "x-nullable": true
        },
        "pensionLinkId": {
          "type": "string",
          "x-nullable": true
        },
        "retrievalResult": {
          "x-nullable": true
        }
      },
      "additionalProperties": false
    }
  },
  "tags": [
    {
      "name": "RetrievedRecordsFunction"
    }
  ]
}