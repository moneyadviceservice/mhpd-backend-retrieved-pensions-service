{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "paths": {
      "@services/*": ["./services/*"],
      "@lib/*": ["./lib/*"],
      "utilities/*": ["./utilities/*"],
      "schemas/*": ["./schemas/*"]
    }
  }
}